---
import Base from '../layouts/Base.astro';
import { loadCurriculum, loadInspire, url, thumb, formatViews } from '../lib/content';

const { levels, steps } = await loadCurriculum();
const featured = (await loadInspire()).filter((i) => i.data.featured);
const daily = featured.map((i) => ({
  href: url(`/inspire/${i.id}/`),
  title: i.data.title,
  who: i.data.dancer || i.data.event,
  views: formatViews(i.data.views),
  img: thumb(i.data.youtubeId),
}));
---

<Base>
  <section class="wrap hero">
    <p class="eyebrow">From the first bounce to the floor</p>
    <h1>Learn <span>House Dance</span><br />Step by Step</h1>
    <p class="lede">
      {steps.length} steps in {levels.length} levels. Watch, slow it down, mirror it, loop the hard part. Then move to the next
      level.
    </p>
    <div class="cta">
      <a class="btn primary" href={url('/levels/0/')}>Start at Level 0</a>
      <a class="btn" href={url('/inspire/')}>Get Inspired</a>
    </div>
  </section>

  {daily.length > 0 && (
    <section class="wrap daily" aria-labelledby="daily-h">
      <p class="eyebrow" id="daily-h">Daily inspiration</p>
      <a class="daily-card" id="daily-card" href={daily[0].href} data-items={JSON.stringify(daily)}>
        <img id="daily-img" src={daily[0].img} alt="" width="480" height="360" />
        <span class="daily-txt">
          <strong id="daily-title">{daily[0].title}</strong>
          <span id="daily-who">{daily[0].who}</span>
          <span class="daily-cta">Watch for motivation →</span>
        </span>
      </a>
    </section>
  )}

  <section class="wrap path" aria-label="Curriculum">
    <ol>
      {levels.map((l) => (
        <li style={`--lv:${l.color}`}>
          <a href={url(`/levels/${l.level}/`)} class="card">
            <span class="num">{l.level}</span>
            <div>
              <h2>{l.title}</h2>
              <p class="goal">{l.goal}</p>
              <p class="meta">{l.steps.length} steps <span class="grad-badge" data-grad={l.level} hidden>· Graduated ✓</span></p>
              <progress class="lvl-progress" data-level={l.level} data-slugs={l.steps.map((s) => s.id).join(',')} value="0" max={l.steps.length} aria-label={`Level ${l.level} progress`}></progress>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<script>
  import { learnedSet, graduatedSet } from '../scripts/progress';
  const card = document.getElementById('daily-card');
  if (card) {
    const items = JSON.parse(card.dataset.items ?? '[]') as { href: string; title: string; who: string; img: string }[];
    const day = Math.floor(Date.now() / 86_400_000);
    const pick = items[day % items.length];
    if (pick) {
      card.setAttribute('href', pick.href);
      (document.getElementById('daily-img') as HTMLImageElement).src = pick.img;
      document.getElementById('daily-title')!.textContent = pick.title;
      document.getElementById('daily-who')!.textContent = pick.who;
    }
  }
  const grads = graduatedSet();
  document.querySelectorAll<HTMLElement>('[data-grad]').forEach((el) => {
    el.hidden = !grads.has(Number(el.dataset.grad));
  });
  const learned = learnedSet();
  document.querySelectorAll<HTMLProgressElement>('.lvl-progress').forEach((el) => {
    const slugs = (el.dataset.slugs ?? '').split(',');
    el.value = slugs.filter((s) => learned.has(s)).length;
  });
</script>

<style>
  .hero {
    padding-block: clamp(24px, 6vw, 64px);
  }
  .hero h1 span {
    color: var(--magenta);
    text-shadow: 0 0 28px rgba(255, 46, 147, 0.45);
  }
  .lede {
    max-width: 52ch;
    color: var(--text-dim);
    font-size: 1.08rem;
    margin: 18px 0 26px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 12px;
    border: 1px solid var(--line);
    text-decoration: none;
    font-weight: 700;
    background: var(--bg-raised);
  }
  .btn:hover {
    background: var(--bg-hover);
  }
  .btn.primary {
    background: var(--magenta);
    border-color: var(--magenta);
    color: #11060c;
  }
  .btn.primary:hover {
    box-shadow: 0 0 24px rgba(255, 46, 147, 0.5);
  }
  .daily {
    margin-bottom: 28px;
  }
  .daily-card {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    margin-top: 10px;
    padding: 12px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-raised);
    text-decoration: none;
    transition: box-shadow 0.15s;
  }
  .daily-card:hover {
    box-shadow: 0 8px 30px -12px var(--magenta);
  }
  .daily-card img {
    flex: 0 0 auto;
    width: min(100%, 240px);
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 10px;
  }
  .daily-txt {
    display: grid;
    gap: 4px;
    flex: 1 1 220px;
  }
  .daily-txt span {
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .daily-txt .daily-cta {
    color: var(--magenta);
    font-weight: 700;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
  }
  .card {
    display: flex;
    gap: 16px;
    height: 100%;
    padding: 20px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    border-left: 6px solid var(--lv);
    background: var(--bg-raised);
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s, background 0.15s;
  }
  .card:hover {
    background: var(--bg-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px -10px var(--lv);
  }
  .num {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    color: var(--lv);
  }
  .goal {
    margin: 8px 0;
    color: var(--text-dim);
    font-size: 0.95rem;
  }
  .meta {
    margin: 0 0 10px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lv);
  }
  progress {
    width: 100%;
    height: 6px;
    appearance: none;
    border: 0;
    border-radius: 99px;
    overflow: hidden;
    background: var(--line);
  }
  progress::-webkit-progress-bar {
    background: var(--line);
  }
  progress::-webkit-progress-value {
    background: var(--lv);
  }
  progress::-moz-progress-bar {
    background: var(--lv);
  }
</style>
