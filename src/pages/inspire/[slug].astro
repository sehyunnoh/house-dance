---
import Base from '../../layouts/Base.astro';
import Player from '../../components/Player.astro';
import { loadCurriculum, loadInspire, url, formatViews, categoryLabel } from '../../lib/content';

export async function getStaticPaths() {
  const [items, { bySlug }] = await Promise.all([loadInspire(), loadCurriculum()]);
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item, steps: item.data.steps.map((s) => bySlug.get(s)!) },
  }));
}

const { item, steps } = Astro.props;
const d = item.data;
const who = [d.dancer, d.event].filter(Boolean).join(' · ');
---

<Base title={d.title} description={d.blurb}>
  <article class="wrap">
    <p class="crumbs"><a href={url('/inspire/')}>Get Inspired</a> / {categoryLabel[d.category]}</p>
    <h1>{d.title}</h1>
    {who && <p class="who">{who}</p>}
    <p class="meta">{formatViews(d.views)} views as of {d.statsAsOf.toISOString().slice(0, 10)} · uploaded {d.uploadedYear}</p>

    <Player videos={[{ id: d.youtubeId, title: d.title, start: 0, kind: 'inspiration' }]} track={false} />

    <p class="blurb">{d.blurb}</p>

    <section class="next">
      <h2>Ready to move?</h2>
      {steps.length > 0 ? (
        <ul>
          {steps.map((s) => <li><a href={url(`/steps/${s.id}/`)}>{s.data.title}</a></li>)}
        </ul>
      ) : (
        <p>Start from the first bounce and work your way up.</p>
      )}
      <a class="btn" href={url('/levels/0/')}>Start at Level 0</a>
    </section>

    <p class="source">
      <a href={`https://www.youtube.com/watch?v=${d.youtubeId}`} target="_blank" rel="noopener">Watch on YouTube</a>
      · All video rights belong to the original creators.
    </p>
  </article>
</Base>

<style>
  .crumbs {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin: 0 0 16px;
  }
  .crumbs a {
    display: inline-block;
    padding: 8px 0;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3.2rem);
  }
  .who {
    margin: 10px 0 0;
    color: var(--text-dim);
  }
  .meta {
    margin: 6px 0 0;
    color: var(--cyan);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .blurb {
    max-width: 62ch;
    font-size: 1.05rem;
  }
  .next {
    margin-top: 32px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }
  .next ul {
    padding-left: 1.1rem;
  }
  .next li a {
    display: inline-block;
    padding: 6px 0;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-top: 8px;
    padding: 0 22px;
    border-radius: 12px;
    background: var(--magenta);
    color: #11060c;
    font-weight: 700;
    text-decoration: none;
  }
  .source {
    margin-top: 24px;
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .source a {
    text-decoration: underline;
  }
</style>
