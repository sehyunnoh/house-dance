---
import Base from '../../layouts/Base.astro';
---

<Base title="Get Inspired" description="Popular and iconic house dance videos to keep you motivated.">
  <section class="wrap">
    <p class="eyebrow">Watch. Feel it. Go practice.</p>
    <h1>Get Inspired</h1>
    <p class="lede">
      A curated shelf of popular and iconic house dance videos is coming soon: battles, cyphers, performances, and classic
      footage, each linked back to the steps you can learn from it.
    </p>
  </section>
</Base>

<style>
  .lede {
    max-width: 56ch;
    color: var(--text-dim);
    margin-top: 16px;
  }
</style>
