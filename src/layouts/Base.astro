---
import '@fontsource/anton/latin-400.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import { url } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'Learn house dance step by step, from foundations to floor work.' } = Astro.props;
const pageTitle = title ? `${title} | House Dance Practice` : 'House Dance Practice';
const path = Astro.url.pathname;
const nav = [
  { href: url('/'), label: 'Path', active: path === url('/') },
  { href: url('/levels/0/'), label: 'Levels', active: path.startsWith(url('/levels')) || path.startsWith(url('/steps')) },
  { href: url('/inspire/'), label: 'Get Inspired', active: path.startsWith(url('/inspire')) },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0A12" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/icons/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="House Practice" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href={url('/')}><span class="dot" aria-hidden="true"></span>HOUSE<em>PRACTICE</em></a>
        <nav aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={n.active ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <p>
        Step descriptions are unverified until marked otherwise. House dance vocabulary varies by teacher and region.
      </p>
    </footer>
    <script is:inline data-goatcounter="https://house-dance.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
    <script is:inline define:vars={{ swUrl: url('/sw.js'), scope: url('/') }}>
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(swUrl, { scope }).catch(() => {});
        });
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 200;
    padding: 12px 16px;
    border-radius: 10px;
    background: var(--cyan);
    color: #06201e;
    font-weight: 700;
    transition: top 0.15s;
  }
  .skip:focus {
    top: 12px;
  }
  main:focus {
    outline: none;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px);
    background: rgba(11, 10, 18, 0.78);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 60px;
  }
  .logo {
    font-family: var(--font-display);
    text-decoration: none;
    font-size: 1.35rem;
    letter-spacing: 0.06em;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .logo em {
    font-style: normal;
    color: var(--magenta);
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--magenta);
    box-shadow: 0 0 14px var(--magenta);
    animation: pulse 0.48s ease-in-out infinite;
  }
  nav {
    display: flex;
    gap: 4px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 10px;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-dim);
  }
  nav a:hover {
    color: var(--text);
    background: var(--bg-hover);
  }
  nav a[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 -3px 0 var(--magenta);
    border-radius: 10px 10px 0 0;
  }
  main {
    padding-block: 28px 64px;
  }
  .site-footer {
    padding-block: 28px;
    padding-bottom: calc(28px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    color: var(--text-dim);
    font-size: 0.85rem;
  }
  @media (max-width: 420px) {
    .logo em {
      display: none;
    }
    nav a {
      padding: 0 8px;
      font-size: 0.85rem;
    }
  }
</style>
