---
import { url, thumb, formatViews } from '../lib/content';

interface Props {
  slug: string;
  title: string;
  youtubeId: string;
  who?: string;
  views: number;
  year: number;
  rank?: number;
}
const { slug, title, youtubeId, who, views, year, rank } = Astro.props;
---

<a class="vcard" href={url(`/inspire/${slug}/`)}>
  <span class="img">
    <img src={thumb(youtubeId)} alt="" loading="lazy" width="480" height="360" />
    {rank && <span class="rank">{rank}</span>}
    <span class="play" aria-hidden="true">▶</span>
  </span>
  <span class="txt">
    <strong>{title}</strong>
    {who && <span class="who">{who}</span>}
    <span class="meta">{formatViews(views)} views · uploaded {year}</span>
  </span>
</a>

<style>
  .vcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-raised);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .vcard:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px -12px var(--magenta);
  }
  .img {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }
  .img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .rank {
    position: absolute;
    top: 8px;
    left: 8px;
    min-width: 32px;
    height: 32px;
    padding: 0 8px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: var(--magenta);
    color: #11060c;
    font-family: var(--font-display);
    font-size: 1.1rem;
  }
  .play {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(11, 10, 18, 0.8);
    border: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .txt {
    display: grid;
    gap: 4px;
    padding: 12px 14px 14px;
  }
  .who {
    color: var(--text-dim);
    font-size: 0.88rem;
  }
  .meta {
    color: var(--cyan);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
</style>
