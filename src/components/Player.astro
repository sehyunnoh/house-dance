---
interface Video {
  id: string;
  title: string;
  start: number;
  kind: string;
}
interface Props {
  videos: Video[];
}
const { videos } = Astro.props;
const first = videos[0];
const speeds = [0.25, 0.5, 0.75, 1];
---

<div
  class="player"
  data-player
  data-first-id={first.id}
  data-first-start={first.start}
  tabindex="-1"
>
  <div class="stage" data-stage>
    <div class="ratio"><div data-mount></div></div>
  </div>
  <p class="message" data-message hidden role="alert"></p>

  {videos.length > 1 && (
    <div class="picker" role="group" aria-label="Choose video">
      {videos.map((v, i) => (
        <button type="button" data-video={v.id} data-start={v.start} aria-pressed={i === 0}>{v.title}</button>
      ))}
    </div>
  )}

  <div class="controls" role="group" aria-label="Practice controls">
    <div class="row transport">
      <button type="button" data-act="back" aria-label="Back 5 seconds">−5s</button>
      <button type="button" data-act="play" class="main" aria-pressed="false">Play</button>
      <button type="button" data-act="fwd" aria-label="Forward 5 seconds">+5s</button>
      <button type="button" data-act="mirror" aria-pressed="false" title="Flip the video like a mirror (M)">Mirror</button>
    </div>
    <div class="row speeds" role="group" aria-label="Playback speed">
      {speeds.map((s) => (
        <button type="button" data-speed={s} aria-pressed={s === 1}>{s}×</button>
      ))}
    </div>
    <div class="row ab" role="group" aria-label="Loop a section">
      <button type="button" data-act="set-a">Set A</button>
      <button type="button" data-act="set-b">Set B</button>
      <button type="button" data-act="loop" aria-pressed="false" disabled>Loop</button>
      <button type="button" data-act="clear">Clear</button>
      <span class="ab-label" data-ab-label aria-live="polite"></span>
    </div>
    <p class="hint">Keys: Left/Right ±5s, 1–4 speed, M mirror, L loop.</p>
  </div>
</div>

<script>
  import { initPlayer } from '../scripts/player';
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((el) => initPlayer(el));
</script>

<style>
  .player {
    margin: 24px 0;
    outline: none;
  }
  .stage {
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
    border: 1px solid var(--line);
  }
  .ratio {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .ratio :global(iframe),
  .ratio > div {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .stage.mirrored .ratio {
    transform: scaleX(-1);
  }
  .message {
    margin: 12px 0 0;
    padding: 12px 14px;
    border: 1px solid var(--amber);
    border-radius: 10px;
    color: var(--amber);
    font-size: 0.9rem;
  }
  .message :global(a) {
    text-decoration: underline;
  }
  .picker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .controls {
    margin-top: 14px;
    display: grid;
    gap: 10px;
    padding: 12px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-raised);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  button {
    min-height: 48px;
    min-width: 48px;
    padding: 0 16px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    flex: 1 1 auto;
    touch-action: manipulation;
  }
  button:hover:not(:disabled) {
    background: var(--bg-hover);
  }
  button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  button[aria-pressed='true'] {
    background: var(--lv, var(--magenta));
    border-color: var(--lv, var(--magenta));
    color: #11060c;
  }
  .main {
    flex: 2 1 120px;
  }
  .picker button {
    flex: 0 1 auto;
    min-height: 40px;
    font-weight: 500;
    font-size: 0.85rem;
  }
  .ab-label {
    flex: 1 1 100%;
    font-variant-numeric: tabular-nums;
    color: var(--text-dim);
    font-size: 0.85rem;
    white-space: pre;
  }
  .hint {
    margin: 0;
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  @media (max-width: 720px) {
    .controls {
      position: sticky;
      bottom: 8px;
      z-index: 40;
      background: rgba(20, 18, 31, 0.94);
      backdrop-filter: blur(12px);
    }
    .hint {
      display: none;
    }
  }
</style>
